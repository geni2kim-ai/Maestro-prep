{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LEONARDO_ROUTE_DECISION_V1 (Maestro-Prep normalized adapter contract, not official Leonardo output)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "work_unit", "node_id", "stage", "intent", "task_sha256", "policy_sha256", "execution_state", "mandatory_skills", "plan_gate", "review_required"],
  "properties": {
    "schema": {"const": "LEONARDO_ROUTE_DECISION_V1"},
    "work_unit": {"type": "string", "minLength": 1},
    "node_id": {"type": "string", "minLength": 1},
    "stage": {"enum": ["PLAN", "EXECUTE", "PUBLISH", "CLOSE"]},
    "intent": {"enum": ["NEW_PLAN", "REPLAN", "REUSE_PLAN", "READ_ONLY"]},
    "task_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "execution_state": {"const": "READY"},
    "mandatory_skills": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "contains": {"const": "o-prep"}},
    "plan_gate": {"enum": ["CALL_ASTRA_PREP", "REUSE_PINNED_PLAN", "NO_NEW_PLAN"]},
    "review_required": {"type": "boolean"}
  },
  "allOf": [
    {"if": {"properties": {"intent": {"enum": ["NEW_PLAN", "REPLAN"]}}},
     "then": {"properties": {"mandatory_skills": {"contains": {"const": "astra-prep"}}, "plan_gate": {"const": "CALL_ASTRA_PREP"}}}},
    {"if": {"properties": {"intent": {"const": "REUSE_PLAN"}}}, "then": {"properties": {"plan_gate": {"const": "REUSE_PINNED_PLAN"}}}},
    {"if": {"properties": {"intent": {"const": "READ_ONLY"}}}, "then": {"properties": {"plan_gate": {"const": "NO_NEW_PLAN"}}}},
    {"if": {"properties": {"stage": {"enum": ["PUBLISH", "CLOSE"]}}}, "then": {"properties": {"review_required": {"const": true}}}}
  ]
}
